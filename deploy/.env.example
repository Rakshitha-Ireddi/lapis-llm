# Copy to deploy/.env and adjust. Every setting is optional except the password.

# Admin password for the console and /api. If unset, one is generated and logged.
LAPIS_ADMIN_PASSWORD=change-me

# Require an API key for /v1 and /metrics (recommended).
LAPIS_REQUIRE_API_KEY=true

# Memory kept free on every node / GPU for the OS and desktop, in GiB.
LAPIS_MEMORY_RESERVE_GIB=1.0

# A node silent for this many seconds is shown as offline.
LAPIS_HEARTBEAT_TIMEOUT_S=30

# Pin the session signing key so admin logins survive restarts (any long random string).
# LAPIS_SESSION_SECRET=

# Browser origins allowed to call the API (e.g. the GitHub Pages console).
# LAPIS_CORS_ORIGINS=https://rakshitha-ireddi.github.io

# Host port for docker compose.
LAPIS_PORT=8080
